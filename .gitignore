# Personal config (created by install.sh; one per machine)
/config.yaml

# SLURM logs + rendered jobs (per-clone, per-machine)
/logs/

# Stray slurm artifacts that occasionally land in repo root during development
/slurm-*.out
/jupyter-tunnel_*.out
/jupyter_lab_*.log

# Editor noise
.DS_Store
*.swp
*~

# NFS silly-rename files: left behind when an open file is replaced/deleted on
# an NFS mount (e.g. editing bin/zcr while a zcr process still has it open).
.nfs*
