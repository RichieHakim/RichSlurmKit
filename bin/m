#!/bin/bash
# m -- session manager, wrapping zmx. zmx keeps sessions alive without a
# terminal emulator in the middle, so output, hyperlinks included, goes
# straight to VS Code. Arguments pass straight through to zmx, except that
# bare `m` lists this node's sessions with the claude running in each.
# Common: m a NAME (attach/create), m hi NAME (scrollback), m k NAME (kill),
# m d (detach all clients of the current session). Ctrl+\ detaches this terminal.
# Usage: m [zmx args...]

set -e
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/mx.sh"

if [[ $# -eq 0 ]]; then
    exec "$RSK_MX_PY" ls
fi
exec zmx "$@"
