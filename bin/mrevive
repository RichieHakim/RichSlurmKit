#!/bin/bash
# mrevive -- bring back zmx claude sessions after their Slurm job ended.
#
# Every claude running inside a zmx (or zellij) session is recorded: session
# name, conversation id, directory, host, job. When the job is gone, mrevive
# recreates the session (detached) in the same directory with `c -r <id>`,
# so the conversation picks up where it stopped. A tool call that was running
# when the job died is not re-run; claude is told it was cut off.
#
# Usage:
#   mrevive                   show recorded sessions and their state
#   mrevive all               revive every 'revivable' session
#   mrevive NAME...           revive these (also works for 'exited' ones)
#   mrevive --forget NAME...  drop records
#   mrevive --dry-run ...     print what would happen
# Then attach with `m a NAME`.

set -e
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/mx.sh"
rsk_mx_snapshot
exec "$RSK_MX_PY" revive "$@"
