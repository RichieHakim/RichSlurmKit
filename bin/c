#!/bin/bash
# claude, plus `claude_flags` from config.yaml (e.g. --dangerously-skip-permissions).
# Without a readable config this is plain `claude`.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

flags=()
config="${RSK_CONFIG:-$root/config.yaml}"
py="$(command -v python3 || command -v python)"
RSK_CLAUDE_FLAGS=""
if [[ -f "$config" && -n "$py" ]]; then
    line="$("$py" "$root/lib/load_config.py" "$config" 2>/dev/null | grep '^RSK_CLAUDE_FLAGS=')"
    [[ -n "$line" ]] && eval "$line"
    read -ra flags <<< "${RSK_CLAUDE_FLAGS:-}"
fi

# Through lib/keep_running.py, so that when Slurm pauses the job (it stops
# every process with SIGTSTP), claude keeps the terminal instead of the shell
# taking it back. Ctrl+Z in claude then does nothing.
keep=()
if py3=$(command -v python3); then
    keep=("$py3" "$root/lib/keep_running.py")
fi
exec "${keep[@]}" claude "${flags[@]}" "$@"
