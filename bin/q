#!/usr/bin/env bash
# Watch sacct for the current user. Usage: q [interval_seconds] [user]
set -euo pipefail

period="${1:-1}"
user_to_show="${2:-$USER}"

if ! [[ $period =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "Invalid interval: '$period'. Provide a positive number (e.g. 5 or 0.5)." >&2
    exit 2
fi

exec watch -n "$period" sacct -u "$user_to_show" -X -s R,PD \
    -o JobID%20,Partition%11,JobName%13,State%2,Elapsed,AllocTRES%50,NodeList,Reason%10
