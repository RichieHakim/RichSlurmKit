// RichSlurmKit zellij config.
//
// Frees Ctrl+o and Ctrl+g globally so the inner program (e.g. Claude Code)
// can use them:
//   Ctrl+o   expand details
//   Ctrl+g   open current message in $EDITOR
//
// We restore zellij's session-mode entry on Ctrl+\ — universally free across
// macOS / Linux / Windows and not eaten by VS Code's integrated terminal.
// (Avoid Alt: on macOS, Option produces special characters like ∂, œ unless
// the terminal is reconfigured.)
//
// Once in session mode:
//   d     Detach (session keeps running)        — zellij default
//   q     Quit   (kills session)                — added here
//   g     Switch to Locked mode (pass-through)  — added here
//   Esc   Back to Normal without doing anything — added here
//
// Locked mode disables every zellij keybinding so keystrokes pass straight
// through to the program inside the pane. To leave Locked mode: Ctrl+\.
//
// ---------------------------------------------------------------------------
// Scrollback (reading earlier output / Claude Code conversation history)
// ---------------------------------------------------------------------------
// zellij runs in the terminal's ALTERNATE screen, so the host terminal's own
// scrollbar (and Shift+wheel in VS Code) can never show history — only zellij's
// own scroll buffer holds it.
//
// Recent Claude Code versions CAPTURE THE MOUSE, so while Claude Code is
// focused the wheel is consumed by Claude Code instead of scrolling zellij's
// buffer. There is exactly one wheel and two consumers; zellij can't route
// clicks to the app while keeping the wheel for itself. The fix is a transient
// hand-off via Scroll mode, where the KEYBOARD always navigates history:
//
//   Ctrl+s            enter Scroll mode
//   j / k             scroll one line   (PageUp/PageDown or Ctrl+f/Ctrl+b = page)
//   d / u             half page down / up
//   wheel             ALSO scrolls IF your zellij reclaims the mouse here
//                     (varies by build; verify once with: Ctrl+s, then wheel up)
//   /                 search backward through scrollback
//   Esc  or  q        jump back to bottom and return to Normal (mouse → app)
//
// We also UNBIND 'e' in Scroll mode: by default it runs EditScrollback, which
// dumps the buffer to a /tmp/*.dump file and opens it in $EDITOR (code --wait)
// — the surprise "a .dump file opened in VS Code" behavior.
//
// Note: mouse_mode is left at its default (true) ON PURPOSE so Claude Code
// keeps its mouse feature; the Scroll-mode hand-off above is what gives the
// wheel back on demand. (Setting it false severs zellij's mouse forwarding, so
// the terminal falls back to translating the wheel into arrow keys -- worse.)
//
// Without `clear-defaults=true` this merges into zellij's defaults instead of
// replacing them. Edit freely; this file is symlinked from $RSK_ROOT/zellij/.

keybinds {
    shared_except "locked" "renametab" "renamepane" "entersearch" {
        unbind "Ctrl o" "Ctrl g"
        // macOS/VS Code send Option+Right as Meta-f (ESC f) and Option+Left as
        // Meta-b (ESC b) -- the readline word-movement sequences. zellij's default
        // binds "Alt f" to ToggleFloatingPanes, which eats Option+Right (the
        // "floating subwindow"). Unbind it so the key passes through to the shell.
        // (Option+Left = "Alt b" is unbound by default, so it already passes through.
        //  Floating panes are still reachable via pane mode: Ctrl+p then w.)
        unbind "Alt f"
        bind "Ctrl \\" { SwitchToMode "Session"; }
    }
    session {
        bind "q" { Quit; }
        bind "g" { SwitchToMode "Locked"; }
        bind "Esc" { SwitchToMode "Normal"; }
    }
    locked {
        unbind "Ctrl g"
        bind "Ctrl \\" { SwitchToMode "Normal"; }
    }
    scroll {
        // Defuse the accidental-.dump footgun.
        unbind "e"
        // Ergonomic exit: snap to bottom and hand the mouse back to the app.
        bind "Esc" "q" { ScrollToBottom; SwitchToMode "Normal"; }
        // Enter search directly with '/' (zellij's default for this is 's').
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
    }
}

// Keep plenty of history available to scroll back through (default is 10000).
scroll_buffer_size 50000

// ---------------------------------------------------------------------------
// Clicking file paths
// ---------------------------------------------------------------------------
// Inside zellij, Cmd/Ctrl+click on a plain file path does nothing (VS Code's
// own path detection doesn't fire through zellij; URLs still work because they
// arrive as OSC 8 hyperlinks). zellij 0.44+ has its own: ALT+CLICK (Option+click
// on macOS) a path and its built-in `link` plugin opens it in this editor, in a
// floating pane. Relative paths resolve against the pane's cwd.
//
// `zopen` (RichSlurmKit bin/) opens the file in VS Code without --wait, so the
// floating pane closes immediately. A bare name because zellij doesn't expand
// $HOME/env vars here; it's resolved on PATH. Line numbers are not passed
// (zellij only forwards them to editors named vim/nvim/emacs/nano/kak/hx).
scrollback_editor "zopen"
